{
  "description": "pixel-office: runs the installed pixel office program (~/.claude/pixel-office/release/codex/codex_office.py) through a launcher that never changes, so upgrades need no reinstall and no new Trust all. Writes this Codex session's status, delivers office mail, marks the session gone on exit. Never blocks Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/po_launch.py\" hook SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/po_launch.py\" hook UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/po_launch.py\" hook PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/po_launch.py\" hook Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/po_launch.py\" hook SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
